# Copy this file to .env and fill in your real keys. .env is gitignored.
# Both keys below are REQUIRED — there is no offline mode. If either is
# missing, or Places can't find a real restaurant nearby, the game ends on a
# game-over screen instead of showing invented data.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4-mini
PORT=3000

# Get a key from Google Cloud Console with "Places API (New)" enabled.
GOOGLE_MAPS_API_KEY=
USER_LOCATION=Toronto, ON
